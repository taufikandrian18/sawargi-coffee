# Internal router behind the host's web server, which terminates HTTPS and forwards
# everything under {$BASE_PATH} here (see deploy/nginx-sawargi.conf).
{
	auto_https off
	servers {
		# Keep the host proxy's X-Forwarded-Proto: https, so WordPress knows it's on HTTPS.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	redir {$BASE_PATH} {$BASE_PATH}/ 308
	# Short admin URLs: /sawargi-coffee/wp-admin → WordPress's real admin under /shop.
	redir {$BASE_PATH}/wp-admin* {$BASE_PATH}/shop/wp-admin/ 302
	redir {$BASE_PATH}/wp-login.php {$BASE_PATH}/shop/wp-login.php 302

	# WordPress + WooCommerce: admin, cart, checkout, payment plugins, Store API.
	@wordpress path {$BASE_PATH}/shop {$BASE_PATH}/shop/*
	handle @wordpress {
		root * /srv/wp
		@blocked path_regexp ^{$BASE_PATH}/shop/(xmlrpc\.php|wp-config\.php|readme\.html|license\.txt|wp-content/uploads/.*\.php)$
		respond @blocked 404
		php_fastcgi sawargi-wordpress:9000 {
			# WordPress is in a subfolder, so its front controller is too.
			try_files {path} {path}/index.php {$BASE_PATH}/shop/index.php
		}
		file_server
	}

	# The designed site (static build of this repo, copied into deploy/site).
	handle_path {$BASE_PATH}/* {
		root * /srv/site
		# Hashed build assets never change; media changes rarely; index.html always revalidates.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@media path /media/* /brand/*
		header @media Cache-Control "public, max-age=604800"
		@html path / /index.html
		header @html Cache-Control "no-cache"

		# SPA fallback: /checkout, /journal/... serve index.html. file_server honours
		# Range requests, which the scroll-scrubbed video needs.
		try_files {path} /index.html
		file_server
	}

	handle {
		respond 404
	}
}
