# Copy to deploy/.env on the VPS and fill in. Never commit the real .env.

# Where the site is served. The front proxy keeps ports 80/443 and the HTTPS
# certificate, and forwards BASE_PATH to this stack (see docs/cms/WORDPRESS.md §2).
PUBLIC_URL=https://website.taufikandrian.my.id
BASE_PATH=/sawargi-coffee
# Docker network of the front proxy container that owns ports 80/443, so it can reach
# this stack as sawargi-caddy:80. Find it with:
#   docker inspect n8n-caddy-1 --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=n8n_default
# Local port for checks from the VPS shell (127.0.0.1 only). Change it if it's taken.
HTTP_PORT=8088

# Database. Use long random values:  openssl rand -base64 24
# Set these BEFORE the first `docker compose up`: MariaDB keeps the first password it starts with.
DB_NAME=sawargi
DB_USER=sawargi
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Used once by bootstrap-wordpress.sh to create the admin account.
WP_ADMIN_USER=sawargi-admin
WP_ADMIN_EMAIL=you@example.com
# Optional. Empty = a random password is generated and printed once.
# If you set one, delete it from this file after the bootstrap has run.
WP_ADMIN_PASSWORD=

# Backups (docs/cms/BACKUPS.md). BACKUP_REMOTE = an rclone remote for the encrypted off-server
# copy, e.g. sawargi-crypt: . Empty = backups stay on this server only.
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=60
