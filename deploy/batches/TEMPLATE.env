# One file per batch. Copy it, fill in the REAL values, then run on the VPS:
#   ./deploy/add-batch.sh deploy/batches/SWG-CN-015.env
# Everything here is shown to customers as fact. Leave a value empty rather than guess:
# the script refuses to run until the required ones are filled in.

CODE=                      # batch code, becomes the product SKU, e.g. SWG-CN-015
ROAST_DATE=                # YYYY-MM-DD
HARVEST=""                 # e.g. "2026 main crop"
CUP_SCORE=                 # optional: your cupping score, e.g. 85.5 (empty = not shown)
NOTES=""                   # tasting notes, comma-separated, e.g. "jackfruit, palm sugar, cacao nib"
BAGS=                      # bags roasted and for sale in this batch (the starting stock)
PRICE_IDR=150000           # per bag, whole rupiah (current price in src/data/shop.ts)
GRINDS="Whole bean,Coarse,Medium,Fine"   # the grinds you'll sell this batch in
STATUS=publish             # publish = live now; draft = check it in WP admin first
